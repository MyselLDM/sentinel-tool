# Sentinel Express API — environment variables
# Copy to `.env` and adjust. Loaded automatically via Node's process.loadEnvFile().

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Port 4000 by default — the Next.js console runs on 3000.
PORT=4000
# Comma-separated allowed browser origins (the console).
CORS_ORIGINS=http://localhost:3000

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED in production (>= 32 random bytes). In development a random ephemeral
# secret is generated if unset (tokens are invalidated on restart).
JWT_SECRET=
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=7d

# ── Inference service (FastAPI) ─────────────────────────────────────────────
INFERENCE_URL=http://localhost:8000
INFERENCE_TIMEOUT_MS=5000
# true  -> never call FastAPI, synthesize deterministic mock scores
INFERENCE_MOCK=false
# true  -> if a real call fails with a connection error, fall back to mock
INFERENCE_MOCK_FALLBACK=false

# ── API keys ────────────────────────────────────────────────────────────────
# Key prefix: sk_live_ in production, sk_test_ otherwise. Override if needed.
API_KEY_PREFIX=
RATE_LIMIT_DEFAULT_PER_MIN=60

# ── Dev conveniences ────────────────────────────────────────────────────────
# Seed a demo user + API key at startup (default: true outside production).
SEED_DEMO=
