# sentinel-client — server-side configuration.
# Copy to `.env.local` (git-ignored) and fill in real values.
#
# These are used ONLY on the server, by the playground proxy at
# `app/api/playground/route.ts`. Never prefix them with NEXT_PUBLIC_ —
# the API key must not reach the browser.

# Base URL of the Express gateway.
SENTINEL_API_URL=http://localhost:4000

# An API key issued by the gateway. Create one in the console, or use the key
# that the Express dev seed logs at startup (run Express with SEED_DEMO_API_KEY
# set to keep it stable across restarts).
SENTINEL_API_KEY=
